# Copy to .env for local development: cp .env.example .env
# The authoritative schema for these variables lives in packages/config/src/schema.ts.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
APP_VERSION=0.1.0
GIT_SHA=local
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=4000
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,tauri://localhost
# Minimum desktop/web client version the server will accept (Phase 8 rollout control).
MIN_SUPPORTED_CLIENT_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# docker-compose.yml creates the role, password and database all named "gobblet".
# Phase 2 needs the role and its password in the connection string; keep the
# populated value in .env only, never in this example file.
DATABASE_URL=postgresql://localhost:5432/gobblet
DATABASE_POOL_MAX=10
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Web client (Vite, must be prefixed with VITE_)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_ENV=local

# ---------------------------------------------------------------------------
# Auth0 (Phase 3 - optional until then)
# ---------------------------------------------------------------------------
# AUTH0_DOMAIN=
# AUTH0_AUDIENCE=
# AUTH0_CLIENT_ID=
# AUTH0_MANAGEMENT_CLIENT_ID=
# AUTH0_MANAGEMENT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Observability (Phase 7 - optional until then)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# METRICS_ENABLED=true
