# Copy to .env for local development: cp .env.example .env
# The authoritative schema for these variables lives in packages/config/src/schema.ts.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
APP_VERSION=0.1.0
GIT_SHA=local
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=4000
PUBLIC_WEB_URL=http://localhost:5173
# The packaged shell's origin differs by platform: tauri://localhost on macOS and
# Linux, http://tauri.localhost on Windows. Both belong in every environment.
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost
# Minimum desktop/web client version the server will accept (Phase 8 rollout control).
MIN_SUPPORTED_CLIENT_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Two supported local setups:
#   1. docker-compose.yml, which creates the role, password and database all named "gobblet".
#   2. A native PostgreSQL 16 server with a "gobblet" role owning "gobblet" and "gobblet_test".
# Add the role and its password to the URL when the server requires them, and keep the
# populated value in .env only, never in this example file.
DATABASE_URL=postgresql://gobblet@localhost:5432/gobblet
DATABASE_POOL_MAX=10
POSTGRES_PORT=5432
# Integration tests truncate their database on every run. Each test suite derives its own
# database from this URL by suffix (apps/server uses "gobblet_test_server") and creates it
# on first use, so the parallel task graph never has two suites sharing one database.
TEST_DATABASE_URL=postgresql://gobblet@localhost:5432/gobblet_test

# ---------------------------------------------------------------------------
# Web client (Vite, must be prefixed with VITE_)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_ENV=local

# ---------------------------------------------------------------------------
# Authentication (Phase 3)
# ---------------------------------------------------------------------------
# Identity is first party: email and password, with opaque server-issued session
# tokens (docs/adr/0017-first-party-email-password-authentication.md). There is no
# external identity provider and therefore no client id or tenant to configure.
# Lifetime of a session token, in days.
# GUEST_SESSION_TTL_DAYS=30
# USER_SESSION_TTL_DAYS=30
# Credential attempts allowed per address per route in a fifteen minute window.
# The browser suite raises it, because there one address stands for every player.
# CREDENTIAL_ATTEMPT_LIMIT=10

# How long a shutdown waits for active matches to settle after it has stopped
# matchmaking. The platform's kill delay must be longer than this, or the drain is
# decoration: on Railway that is drainingSeconds in apps/server/railway.json.
# SHUTDOWN_DRAIN_SECONDS=30

# ---------------------------------------------------------------------------
# Observability (Phase 7 - optional until then)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# METRICS_ENABLED=true
# Required to read GET /metrics once metrics are enabled outside local. At least
# sixteen characters; without it the route is open, which is only safe locally.
# METRICS_TOKEN=
# Product analytics. Without a key nothing is sent and nothing fails.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# The HMAC key behind the pseudonym that stands in for an account id in logs,
# analytics and error reports. Set it in every deployed environment, and never
# rotate it casually: a new key breaks the link between a session's past and future.
# TELEMETRY_PSEUDONYM_SECRET=
# Client telemetry events accepted per address in a fifteen minute window.
# TELEMETRY_ATTEMPT_LIMIT=60
