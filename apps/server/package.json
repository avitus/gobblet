{
  "name": "@gobblet/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative Fastify HTTP API and real-time runtime for Gobblet Online",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "admin:grant": "tsx --env-file-if-exists=../../.env src/cli/grant-admin.ts",
    "ops:alerts": "tsx src/cli/write-alert-rules.ts",
    "ops:dashboards": "tsx src/cli/write-dashboards.ts",
    "ops:defects": "tsx src/cli/defects.ts",
    "ops:secrets": "tsx src/cli/secret-scan.ts",
    "gates": "tsx src/cli/gates.ts",
    "load": "tsx src/cli/load.ts",
    "desktop-release": "tsx src/cli/desktop-release.ts",
    "smoke": "tsx src/cli/smoke.ts",
    "client-smoke": "tsx src/cli/client-smoke.ts",
    "await-release": "tsx src/cli/await-release.ts",
    "check-release": "tsx src/cli/check-release.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@gobblet/auth": "workspace:*",
    "@gobblet/config": "workspace:*",
    "@gobblet/db": "workspace:*",
    "@gobblet/game-core": "workspace:*",
    "@gobblet/protocol": "workspace:*",
    "@sentry/node": "^10.68.0",
    "fastify": "^5.4.0",
    "posthog-node": "^5.46.1",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "socket.io-client": "^4.8.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
