{
  "name": "@gobblet/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative Fastify HTTP API and real-time runtime for Gobblet Online",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@gobblet/config": "workspace:*",
    "@gobblet/db": "workspace:*",
    "@gobblet/game-core": "workspace:*",
    "@gobblet/protocol": "workspace:*",
    "fastify": "^5.4.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "socket.io-client": "^4.8.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
