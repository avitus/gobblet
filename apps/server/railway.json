{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/server/Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "multiRegionConfig": {
      "us-west2": {
        "numReplicas": 1
      }
    },
    "overlapSeconds": 30,
    "drainingSeconds": 90
  }
}
