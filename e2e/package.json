{
  "name": "@gobblet/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright browser suite: a complete match in Chromium, WebKit and, nightly, Firefox (docs/adr/0021, docs/adr/0041)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "browsers": "playwright install chromium webkit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint helpers setup tests playwright.config.ts",
    "test:e2e:firefox": "playwright test --project=firefox",
    "browsers:firefox": "playwright install firefox"
  },
  "devDependencies": {
    "@gobblet/db": "workspace:*",
    "@gobblet/protocol": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
