{
  "uid": "gobblet-clients",
  "title": "Gobblet clients and releases",
  "description": "What is connected, and how a desktop release is landing.",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connected sockets",
      "description": "How many clients are connected?",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(gobblet_socket_connections)",
          "legendFormat": "connected",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Connections and reconnections",
      "description": "Are clients being dropped and coming back?",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(gobblet_socket_connections_total[5m]))",
          "legendFormat": "connects",
          "refId": "A"
        },
        {
          "expr": "sum(rate(gobblet_socket_reconnects_total[5m]))",
          "legendFormat": "reconnects",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Sessions by platform and version",
      "description": "Which builds are in players' hands?",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (platform, client_version) (increase(gobblet_client_sessions_total[5m]))",
          "legendFormat": "{{platform}} {{client_version}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Desktop update checks",
      "description": "Are desktop clients asking for updates, and on which channel?",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (channel, result) (increase(gobblet_desktop_update_checks_total[5m]))",
          "legendFormat": "{{channel}} {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Desktop update outcomes",
      "description": "Is the update installing, or failing on players' machines?",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(gobblet_desktop_update_outcomes_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Signing failures",
      "description": "Did a release go out unsigned, or fail to sign?",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(increase(gobblet_desktop_signing_failures_total[5m]))",
          "legendFormat": "failures",
          "refId": "A"
        }
      ]
    }
  ]
}
