{
  "name": "gobblet-online",
  "version": "0.1.0",
  "private": true,
  "description": "Gobblet Online - real-time online 4x4 Gobblet for web, macOS and Windows",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:apps": "turbo run dev --filter=@gobblet/server --filter=@gobblet/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:properties:nightly": "turbo run test:properties:nightly",
    "test:e2e": "pnpm --filter @gobblet/e2e run test:e2e",
    "test:e2e:browsers": "pnpm --filter @gobblet/e2e run browsers",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:generate": "pnpm --filter @gobblet/db db:generate",
    "db:migrate": "pnpm --filter @gobblet/db db:migrate",
    "admin:grant": "pnpm --filter @gobblet/server admin:grant",
    "verify": "turbo run typecheck lint test:coverage build"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
